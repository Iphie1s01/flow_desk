# ── Neon: two roles, three connection strings ──────────────────────────────
# Owner role (neondb_owner). Used ONLY by `npm run db:migrate|db:seed|db:test`. Never deployed to the app.
DATABASE_URL_ADMIN=postgresql://neondb_owner:***@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# flowdesk_app role (created by the migration). RLS is enforced for this role. Use the POOLED host (-pooler).
DATABASE_URL=postgresql://flowdesk_app:***@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# flowdesk_auth role. Can only touch Better Auth's tables.
AUTH_DATABASE_URL=postgresql://flowdesk_auth:***@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Passwords the migration sets on the two roles (must match the URLs above)
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=              # optional; redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_SECRET=

# ── Email (Resend, free tier). Without a key, links are printed to the server console ──
RESEND_API_KEY=
MAIL_FROM="FlowDesk <onboarding@resend.dev>"

# ── Private file storage (Cloudflare R2, S3-compatible). Optional ──────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Public read-only demo login (optional; the user must be a 'viewer' in the seeded workspace) ──
DEMO_EMAIL=
DEMO_PASSWORD=